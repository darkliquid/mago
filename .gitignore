# Native runtime artifacts
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exp

# Local build outputs
bin/
dist/

# Test binaries and coverage output
*.test
*.out
coverage.*

# Miniaudio source files (fetched and generated)
miniaudio.c
miniaudio.h

# Allow native libraries in internal/lib/ to be tracked in git for embedding
!internal/lib/**/*.so
!internal/lib/**/*.dylib
!internal/lib/**/*.dll
